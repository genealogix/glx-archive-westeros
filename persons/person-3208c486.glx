persons:
    person-zollo:
        properties:
            alias:
                - value: Zollo the Fat
            gender: male
            name:
                fields:
                    given: Zollo
                value: Zollo
        notes: A fat Dothraki sellsword in Vargo Hoat's Brave Companions (Bloody Mummers). Wields a huge curved arakh. He is the one who cuts off Jaime Lannister's sword hand on Vargo Hoat's order (ASOS Jaime III).
