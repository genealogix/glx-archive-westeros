  exile:
    label: "Exile"
    description: "Archive-specific event_type term: exile."
  guest_right_violation:
    label: "Guest right violation"
    description: "Archive-specific event_type term: guest right violation."
  kingsmoot:
    label: "Kingsmoot"
    description: "Archive-specific event_type term: kingsmoot."
  knighting:
    label: "Knighting"
    description: "Archive-specific event_type term: knighting."
  marriage_ceremony:
    label: "Marriage ceremony"
    description: "Archive-specific event_type term: marriage ceremony."
  mutiny:
